# ── Velum Web App — Environment Variables ─────────────────────────────────────
# Copy this file to .env.local and fill in the deployed contract addresses.
# Run `cd contracts && npx hardhat run script/deploy.ts --network amoy` first,
# then copy the addresses from contracts/deployments/amoy.json.
#
# .env.local is in .gitignore — never commit it.

# ── Smart Contract Addresses (Polygon Amoy testnet) ───────────────────────────
NEXT_PUBLIC_RECORD_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ACCESS_CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CREDENTIAL_ISSUER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# ── Optional: WalletConnect Project ID ───────────────────────────────────────
# Register a free project at https://cloud.walletconnect.com to suppress the
# RainbowKit console warning. Not required for demo mode.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Optional: IPFS node URL ───────────────────────────────────────────────────
# Defaults to the local ipfs-sim server at localhost:4001.
# Set this to a Pinata or Infura IPFS gateway URL for production.
NEXT_PUBLIC_IPFS_URL=http://localhost:4001
